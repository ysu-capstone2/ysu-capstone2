GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Per server process; 0 disables new Gemini calls.
GEMINI_DAILY_LIMIT=30
GEMINI_MINUTE_LIMIT=5
# Optional: legacy statistics API, unused by the chatbot.
DATA_GO_KR_SERVICE_KEY=

# Supabase Auth, complaints, administrator dashboard, and queue.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 회원 인증용 공개 키 (service_role/secret 키를 넣지 마세요)
SUPABASE_PUBLISHABLE_KEY=
